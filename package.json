{
  "name": "agentproof-typescript",
  "version": "0.1.0",
  "description": "Typed local workflow-trace capture and bounded Node interoperability for AgentProof evidence.",
  "license": "Apache-2.0",
  "author": "Kingsley Okafor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentproof-typescript": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .test-dist coverage artifacts sbom",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:compile": "tsc -p tsconfig.test.json && mkdir -p .test-dist/fixtures && cp fixtures/*.json .test-dist/fixtures/",
    "test": "pnpm test:compile && c8 --all --include='.test-dist/src/**/*.js' --exclude='.test-dist/src/cli.js' --reporter=text --reporter=json --check-coverage --branches 95 --lines 95 --functions 95 --statements 95 node --test .test-dist/tests/all.test.js",
    "sbom": "node scripts/generate-sbom.mjs",
    "pack:check": "pnpm pack --pack-destination artifacts && node scripts/check-package.mjs artifacts",
    "validate": "pnpm clean && pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm sbom && pnpm pack:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsokafor777-droid/agentproof-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/kingsokafor777-droid/agentproof-typescript/issues"
  },
  "homepage": "https://github.com/kingsokafor777-droid/agentproof-typescript#readme",
  "keywords": [
    "ai-agents",
    "agent-security",
    "typescript",
    "nodejs",
    "opentelemetry",
    "workflow-security"
  ],
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "c8": "10.1.3",
    "eslint": "9.20.1",
    "globals": "15.15.0",
    "prettier": "3.9.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0"
  }
}
